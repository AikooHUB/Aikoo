local dragTarget = nil
local dragging = false
local dragStart, startPos

local function isButton(inst)
    if not inst then return false end
    if inst:IsA("TextButton") or inst:IsA("ImageButton") then return true end
    return isButton(inst.Parent)
end

main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if isButton(input.Parent) then return end
        dragTarget = main
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                dragTarget = nil
            end
        end)
    end
end)

bubble.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if isButton(input.Parent) then return end
        dragTarget = bubble
        dragging = true
        dragStart = input.Position
        startPos = bubble.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                dragTarget = nil
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and dragTarget and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if dragTarget == main then
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            shadow.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X - 5, startPos.Y.Scale, startPos.Y.Offset + delta.Y - 5)
        elseif dragTarget == bubble then
            bubble.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end
end)

-- ==================== ENGINE ====================
local targetParts = {}
local running = false
local timerRunning = false
local timerStart = 0
local timerDuration = 120 -- 2 menit
local character = Player.Character
local rootPart = character and character:FindFirstChild("HumanoidRootPart")
local tpLoop = nil
local timerConnection = nil
local tpDone = false

local function updateCharacter()
    character = Player.Character
    if character then
        rootPart = character:FindFirstChild("HumanoidRootPart")
    end
end
updateCharacter()
Player.CharacterAdded:Connect(updateCharacter)

local function scanParts()
    targetParts = {}
    local trophy = workspace:FindFirstChild("Trophy")
    if not trophy then
        infoLabel.Text = "❌ Trophy not found"
        progressLabel.Text = "0 parts"
        return 0
    end
    for _, child in ipairs(trophy:GetDescendants()) do
        if child:IsA("BasePart") then
            table.insert(targetParts, child)
        end
    end
    table.sort(targetParts, function(a, b) return a.Name < b.Name end)
    infoLabel.Text = "Parts: " .. #targetParts .. " | Timer: " .. math.floor(timerRunning and (timerDuration - (tick() - timerStart)) or 0) .. "s"
    progressLabel.Text = #targetParts .. " parts found"
    return #targetParts
end

local function teleportToPart(part)
    if not part or not part.Parent then return false end
    if not rootPart or not rootPart.Parent then
        updateCharacter()
        if not rootPart then return false end
    end
    pcall(function()
        rootPart.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
    end)
    return true
end

local function doSingleTeleport()
    if #targetParts == 0 then
        statusLabel.Text = "❌ No parts"
        return
    end
    local part = targetParts[1] -- hanya part pertama
    if part and part.Parent then
        local success = teleportToPart(part)
        if success then
            progressLabel.Text = "✅ Teleported to " .. part.Name
            statusLabel.Text = "✅ Done - Off"
            infoLabel.Text = "Parts: " .. #targetParts .. " | Done"
        else
            progressLabel.Text = "❌ Failed"
            statusLabel.Text = "❌ Teleport failed"
        end
    else
        progressLabel.Text = "❌ Part missing"
        statusLabel.Text = "❌ Part missing"
    end
    -- Matikan semuanya
    running = false
    timerRunning = false
    if timerConnection then
        timerConnection:Disconnect()
        timerConnection = nil
    end
    if tpLoop then
        task.cancel(tpLoop)
        tpLoop = nil
    end
    actionBtn.Text = "▶ START"
    actionBtn.BackgroundColor3 = C.GREEN
end

local function startTimer()
    if running then return end
    scanParts()
    if #targetParts == 0 then
        statusLabel.Text = "❌ No parts found"
        return
    end
    running = true
    timerRunning = true
    timerStart = tick()
    tpDone = false
    actionBtn.Text = "⏹ STOP"
    actionBtn.BackgroundColor3 = C.RED
    statusLabel.Text = "⏳ Waiting " .. timerDuration .. "s..."
    progressLabel.Text = "Countdown: " .. timerDuration .. "s"

    timerConnection = RunService.Heartbeat:Connect(function()
        if not running then
            timerConnection:Disconnect()
            timerConnection = nil
            return
        end
        local elapsed = tick() - timerStart
        local remaining = math.max(0, timerDuration - elapsed)
        infoLabel.Text = "Parts: " .. #targetParts .. " | Timer: " .. math.floor(remaining) .. "s"
        progressLabel.Text = "Countdown: " .. math.floor(remaining) .. "s"

        if remaining <= 0 then
            timerConnection:Disconnect()
            timerConnection = nil
            timerRunning = false
            statusLabel.Text = "✅ Timer done! Teleporting once..."
            -- Teleport sekali
            doSingleTeleport()
        end
    end)
end

local function stopAutoTP()
    running = false
    timerRunning = false
    if tpLoop then
        task.cancel(tpLoop)
        tpLoop = nil
    end
    if timerConnection then
        timerConnection:Disconnect()
        timerConnection = nil
    end
    statusLabel.Text = "⏸ Stopped"
    progressLabel.Text = ""
    actionBtn.Text = "▶ START"
    actionBtn.BackgroundColor3 = C.GREEN
end

actionBtn.MouseButton1Click:Connect(function()
    if running then
        stopAutoTP()
    else
        startTimer()
    end
end)

scanParts()

gui.Destroying:Connect(function()
    if running then
        running = false
        if tpLoop then task.cancel(tpLoop); tpLoop = nil end
        if timerConnection then timerConnection:Disconnect(); timerConnection = nil end
    end
end)

print("🏆 Trophy TP (120s cooldown, single TP) loaded. Parts: " .. #targetParts)
