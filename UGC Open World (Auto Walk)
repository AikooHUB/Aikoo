-- ==================== ENGINE ====================
local running = false
local walkLoop = nil
local character = Player.Character
local rootPart = character and character:FindFirstChild("HumanoidRootPart")
local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
local targetPosition = nil
local stuckCount = 0
local lastPosition = Vector3.new()
local mapBounds = {minX = -5000, maxX = 5000, minZ = -5000, maxZ = 5000}

local function updateCharacter()
    character = Player.Character
    if character then
        rootPart = character:FindFirstChild("HumanoidRootPart")
        humanoid = character:FindFirstChildWhichIsA("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = speedValue
        end
    end
end
updateCharacter()
Player.CharacterAdded:Connect(updateCharacter)

local function detectMapBounds()
    local minX, maxX = math.huge, -math.huge
    local minZ, maxZ = math.huge, -math.huge
    local found = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local pos = obj.Position
            if pos.X < minX then minX = pos.X end
            if pos.X > maxX then maxX = pos.X end
            if pos.Z < minZ then minZ = pos.Z end
            if pos.Z > maxZ then maxZ = pos.Z end
            found = true
        end
    end
    if found then
        mapBounds.minX = minX - 100
        mapBounds.maxX = maxX + 100
        mapBounds.minZ = minZ - 100
        mapBounds.maxZ = maxZ + 100
    end
end
detectMapBounds()

local function getRandomMapTarget()
    if not rootPart then return nil end
    local tries = 0
    while tries < 20 do
        local x = math.random(mapBounds.minX, mapBounds.maxX)
        local z = math.random(mapBounds.minZ, mapBounds.maxZ)
        local target = Vector3.new(x, 0, z)
        local rayOrigin = target + Vector3.new(0, 200, 0)
        local ray = Ray.new(rayOrigin, Vector3.new(0, -400, 0))
        local hit, hitPos = workspace:FindPartOnRayWithIgnoreList(ray, {character})
        if hit and hitPos then
            target = Vector3.new(target.X, hitPos.Y + 2, target.Z)
            return target
        end
        tries = tries + 1
    end
    local pos = rootPart.Position
    local angle = math.random() * 2 * math.pi
    local radius = math.random(200, 800)
    return pos + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
end

task.spawn(function()
    while gui and gui.Parent do
        task.wait(0.05)
        if running and humanoid and humanoid.Parent then
            if humanoid.WalkSpeed ~= speedValue then
                humanoid.WalkSpeed = speedValue
            end
        end
    end
end)

local function startWalk()
    if running then return end
    running = true
    actionBtn.Text = "⏹ STOP"
    actionBtn.BackgroundColor3 = C.RED
    statusLabel.Text = "🗺️ Exploring full map..."
    stuckCount = 0
    lastPosition = rootPart and rootPart.Position or Vector3.new()
    targetPosition = getRandomMapTarget()
    if humanoid then
        humanoid.WalkSpeed = speedValue
        if targetPosition then
            humanoid:MoveTo(targetPosition)
        end
    end

    walkLoop = task.spawn(function()
        while running do
            if not character or not character.Parent then
                Player.CharacterAdded:Wait()
                updateCharacter()
                task.wait(0.5)
                continue
            end
            if not humanoid or not rootPart then
                updateCharacter()
                task.wait(0.5)
                continue
            end
            humanoid.WalkSpeed = speedValue

            local currentPos = rootPart.Position
            if not targetPosition or (currentPos - targetPosition).Magnitude < 10 then
                targetPosition = getRandomMapTarget()
                if targetPosition and humanoid then
                    humanoid:MoveTo(targetPosition)
                    statusLabel.Text = "🗺️ Moving to new area"
                end
            end

            local distMoved = (currentPos - lastPosition).Magnitude
            if distMoved < 0.5 then
                stuckCount = stuckCount + 1
                if stuckCount > 20 then
                    if humanoid then
                        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                    task.wait(0.2)
                    targetPosition = getRandomMapTarget()
                    if targetPosition and humanoid then
                        humanoid:MoveTo(targetPosition)
                    end
                    stuckCount = 0
                    statusLabel.Text = "🔄 Jump & redirect"
                end
            else
                stuckCount = 0
            end
            lastPosition = currentPos

            task.wait(0.1)
        end
        running = false
        actionBtn.Text = "▶ START"
        actionBtn.BackgroundColor3 = C.GREEN
        statusLabel.Text = "⏸ Stopped"
        if humanoid then
            humanoid:MoveTo(rootPart and rootPart.Position or Vector3.new())
            humanoid.WalkSpeed = 16
        end
        walkLoop = nil
    end)
end

local function stopWalk()
    running = false
    if walkLoop then
        task.cancel(walkLoop)
        walkLoop = nil
    end
    if humanoid then
        humanoid:MoveTo(rootPart and rootPart.Position or Vector3.new())
        humanoid.WalkSpeed = 16
    end
    actionBtn.Text = "▶ START"
    actionBtn.BackgroundColor3 = C.GREEN
    statusLabel.Text = "⏸ Stopped"
end

actionBtn.MouseButton1Click:Connect(function()
    if running then
        stopWalk()
    else
        startWalk()
    end
end)

-- ==================== DRAG ====================
local dragTarget = nil
local dragging = false
local dragStart, startPos

main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragTarget = main
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                dragTarget = nil
            end
        end)
    end
end)

bubble.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragTarget = bubble
        dragging = true
        dragStart = input.Position
        startPos = bubble.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                dragTarget = nil
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and dragTarget and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        dragTarget.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
        if dragTarget == main then
            shadow.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X - 5,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y - 5
            )
        end
    end
end)

